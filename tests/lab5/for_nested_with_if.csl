// Interaction: nested for loops with a conditional choosing each cell.
for (var row = 0; row < 3; row = row + 1) {
    var line = "";
    for (var col = 0; col < 3; col = col + 1) {
        if (row == col) line = line + "#"; else line = line + ".";
    }
    print line;
}
// expect: #..
// expect: .#.
// expect: ..#
