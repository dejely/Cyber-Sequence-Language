// `else if` is an else whose statement is another if; no extra rule needed.
var score = 95;
var grade = "none";
if (score >= 90) {
    grade = "A";
} else if (score >= 80) {
    grade = "B";
} else {
    grade = "F";
}
print grade; // expect: A

score = 85;
if (score >= 90) grade = "A"; else if (score >= 80) grade = "B"; else grade = "F";
print grade; // expect: B

score = 10;
if (score >= 90) grade = "A"; else if (score >= 80) grade = "B"; else grade = "F";
print grade; // expect: F
