((3 + 4) * 2 - 5) / 3 == 3; // expect: true
1 + 2 * 3 > 6 == !nil; // expect: true
// (5 - 2) * 4 / 2 = 6; 6 + -2 = 4; 4 >= 4 is true; !false is true.
(5 - (3 - 1)) * 4 / 2 + -(6 / 3) >= 4 == !false; // expect: true
